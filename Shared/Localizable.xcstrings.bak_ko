    "价格以 App Store 当前显示为准。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "价格以 App Store 当前显示为准。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Current pricing is shown by the App Store."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "價格以 App Store 目前顯示為準。"
