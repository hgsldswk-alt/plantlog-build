    "先摸一摸，干了再考虑浇水。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先摸一摸，干了再考虑浇水。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Feel the soil first. If it's dry, consider watering."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "先摸一摸，乾了再考慮澆水。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まず土を触ってみて。乾いていたら水やりを検討しましょう。"
          }
        }
      }
    },
    "免费凭证只用于补充恢复资格，不会重新计时。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "免费凭证只用于补充恢复资格，不会重新计时。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The free receipt helps restore trial access. It does not restart the clock."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "免費憑證只用於補充恢復資格，不會重新計時。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "無料のレシートはお試しの復元に役立ちます。期間がやり直しになることはありません。"
          }
        }
      }
    },
