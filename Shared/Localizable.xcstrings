    "30 天高级体验已结束。你的植物、照片和提醒照常使用。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "30 天高级体验已结束。你的植物、照片和提醒照常使用。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your 30-day Pro trial is over. Your plants, photos, and reminders still work."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "30 天進階體驗已結束。你的植物、照片和提醒照常使用。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "30日間のProお試しが終了しました。植物、写真、リマインダーは引き続き使えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "30일 Pro 체험이 끝났습니다. 식물, 사진, 알림은 계속 작동합니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine 30-tägige Pro-Testphase ist vorbei. Pflanzen, Fotos und Erinnerungen funktionieren weiter."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu prueba Pro de 30 días terminó. Tus plantas, fotos y recordatorios siguen funcionando."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton essai Pro de 30 jours est terminé. Tes plantes, photos et rappels fonctionnent toujours."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu teste Pro de 30 dias terminou. Suas plantas, fotos e lembretes continuam funcionando."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La prova Pro di 30 giorni è terminata. Piante, foto e promemoria continuano a funzionare."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je Pro-proef van 30 dagen is afgelopen. Je planten, foto's en herinneringen werken nog."
          }
        }
      }
    },
