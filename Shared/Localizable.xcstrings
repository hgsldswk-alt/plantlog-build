    "每隔 %lld 天看看盆土，是否浇水由你判断。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每隔 %lld 天看看盆土，是否浇水由你判断。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check the soil every %lld days and decide whether to water."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每隔 %lld 天看看盆土，是否澆水由你判斷。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld日ごとに土を確認して、水やりするか決めましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld일마다 흙을 확인하고 물을 줄지 정하세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prüfe alle %lld Tage die Erde und entscheide, ob du gießt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Revisa la tierra cada %lld días y decide si regar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifie la terre tous les %lld jours et décide s’il faut arroser."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifique a terra a cada %lld dias e decida se precisa regar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Controlla il terriccio ogni %lld giorni e decidi se annaffiare."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Controleer elke %lld dagen de grond en beslis of je water geeft."
          }
        }
      }
    },
    "没有保存，请重试。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
