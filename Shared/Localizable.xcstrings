    "昵称限 1–40 个字符。照片和提醒可以稍后添加。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "昵称限 1–40 个字符。照片和提醒可以稍后添加。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use 1–40 characters. You can add photos and reminders later."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "暱稱限 1–40 個字元。照片和提醒可以稍後新增。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1〜40文字で入力してください。写真やリマインダーはあとから追加できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "1–40자로 입력하세요. 사진과 알림은 나중에 추가할 수 있습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "1–40 Zeichen. Fotos und Erinnerungen kannst du später hinzufügen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa de 1 a 40 caracteres. Puedes agregar fotos y recordatorios después."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "De 1 à 40 caractères. Tu pourras ajouter photos et rappels plus tard."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Use de 1 a 40 caracteres. Você pode adicionar fotos e lembretes depois."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa da 1 a 40 caratteri. Puoi aggiungere foto e promemoria più tardi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gebruik 1–40 tekens. Foto's en herinneringen kun je later toevoegen."
          }
        }
      }
    },
